# Copy this file to .env (gitignored) and fill in real values:  cp env.example .env
# The .env loader in common.py reads KEY=VALUE lines; shell env wins over .env.
# NEVER commit .env. Values are never logged by the pipeline.

# ── Text generation (Claude) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Image generation (Gemini "nano banana") ───────────────────────────────
GEMINI_API_KEY=...

# ── Keyword source (SerpReport) ───────────────────────────────────────────
# The view_key grants read access to the whole project — treat as a secret.
SERPREPORT_VIEW_URL=https://serpreports.com/app/project/<id>?view_key=<token>

# ── Shopify (Admin API) ────────────────────────────────────────────────────
SHOPIFY_STORE=your-store.myshopify.com
# The token publisher.py uses. Two ways to get it:
#  A) Custom app in the store admin (Settings -> Apps -> Develop apps) ->
#     configure scopes (write_content, read_content, write_files, read_files) ->
#     install -> API credentials tab -> reveal the Admin API access token.
#  B) Partner/dev-dashboard app: mint it once with shopify_oauth.py using the
#     client id/secret below (python shopify_oauth.py).
SHOPIFY_ADMIN_TOKEN=shpat_...

# ── Shopify OAuth bootstrap (only for shopify_oauth.py; not used at run time) ─
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_OAUTH_REDIRECT=https://localhost/callback
