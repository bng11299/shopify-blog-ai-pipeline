# Copy this file to .env and fill in the blanks locally.
# .env is gitignored and is NEVER committed or copied between machines —
# re-provision by hand on each machine (see WorkSetup/migrate/MIGRATION.md).

# --- Shopify store ---
# Store domain only, no scheme: e.g. your-store.myshopify.com
SHOPIFY_STORE=
# Admin API access token. Shopify admin -> Settings -> Apps and sales channels
# -> Develop apps -> your app -> API credentials. Starts "shpat_".
SHOPIFY_ADMIN_TOKEN=

# --- Shopify OAuth app (only needed for the OAuth flow, not for admin-token use) ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_OAUTH_REDIRECT=http://localhost:3000/auth/callback

# --- Model providers ---
# console.anthropic.com -> API keys. Starts "sk-ant-".
ANTHROPIC_API_KEY=
# aistudio.google.com/apikey
GEMINI_API_KEY=

# --- SERP research ---
# Private SerpReport view URL. May carry an embedded token, so treat this as a
# secret rather than a plain config value.
SERPREPORT_VIEW_URL=
